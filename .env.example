# ---------------------------------------------------------------------------
# ALMATE Propiedades — variables de entorno (ejemplo)
# Copiar a `.env` en la raíz del proyecto y ajustar los valores.
# NUNCA subir un archivo .env real al repositorio.
# ---------------------------------------------------------------------------

# Entorno: development | production | test
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Base de datos.
# SQLite (por defecto): ruta relativa a backend/
DATABASE_URL=sqlite:///./almate.db
# Ejemplo PostgreSQL (requiere instalarlo y crear la base):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/almate

# Seguridad — OBLIGATORIO en producción: generar un valor propio, por ejemplo
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# En desarrollo se usa un valor inseguro por defecto (la app avisa en el arranque).
SECRET_KEY=cambiar-por-una-clave-secreta-larga-en-produccion

# Duración del token de sesión (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límites de subida de fotografías
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_PROPERTY=30

# Carpeta de fotografías subidas (relativa a backend/)
UPLOAD_DIR=app/static/uploads

# --- Frontend (Vite) -----------------------------------------------------
# Puerto del dev server
FRONTEND_PORT=5173
# URL del backend usada por Vite para armar el proxy (solo servidor de desarrollo)
VITE_API_TARGET=http://127.0.0.1:8000
